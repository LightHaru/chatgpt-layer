{
  "name": "chatgpt-layer",
  "version": "1.1.4",
  "description": "Installer CLI for ChatGPT Layer, a local tweak system for the ChatGPT desktop app. Unofficial, not affiliated with OpenAI.",
  "author": "LightHaru",
  "keywords": ["chatgpt", "cli", "installer", "tweaks", "electron", "codex"],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/LightHaru/chatgpt-layer.git",
    "directory": "packages/installer"
  },
  "bugs": {
    "url": "https://github.com/LightHaru/chatgpt-layer/issues"
  },
  "homepage": "https://github.com/LightHaru/chatgpt-layer#readme",
  "bin": {
    "chatgpt-layer": "dist/cli.js",
    "cgl": "dist/cli.js",
    "codexplusplus": "dist/cli.js",
    "codex-plusplus": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "bundle-sdk": "node ./scripts/bundle-sdk.mjs",
    "copy-assets": "node ./scripts/copy-assets.mjs",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@electron/asar": "^3.4.0",
    "kleur": "^4.1.5",
    "plist": "^3.1.0",
    "prompts": "^2.4.2",
    "sade": "^1.8.1",
    "tar": "^7.5.2"
  },
  "devDependencies": {
    "@types/plist": "^3.0.5",
    "@types/prompts": "^2.4.9",
    "@types/tar": "^6.1.13",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
